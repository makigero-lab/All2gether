# ---------------------------------------------------------------
# All2gether Backend - Variáveis de ambiente
# Copia este ficheiro para ".env" e preenche com os teus valores.
# NUNCA faças commit do ficheiro ".env" real.
# ---------------------------------------------------------------

# URI de ligação ao MongoDB (MongoDB Atlas, Render, etc.)
MONGODB_URI=mongodb://localhost:27017/all2gether

# Porta onde a API vai ouvir (no Render costuma ser injetada automaticamente)
PORT=5000

# Segredo usado para assinar/verificar os JWT (USE UM VALOR ALEATÓRIO LONGO EM PRODUÇÃO).
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=all2gether-dev-secret-change-me

# Tempo de expiração dos JWT (formato jsonwebtoken: ex. "7d", "12h", "3600s").
JWT_EXPIRACAO=7d

# URL do frontend (para CORS — apenas esta origem é aceita).
# Em produção: https://all2gether.vercel.app (ou o teu domínio Vercel)
FRONTEND_URL=http://localhost:3000

# --- Single Sign-On (SSO) com o portal Autocell ---
# Segredo partilhado entre o Autocell (emissor) e o All2gether (receptor).
# O Autocell assina um JWT externo com esta chave; o endpoint
# GET /api/auth/sso valida-o e inicia a sessão do admin no All2gether.
# TEM de ser idêntico nos dois sistemas. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Se ficar vazio, o SSO fica desativado (o endpoint devolve ?erro=sso_falhou).
AUTOCELL_SSO_SECRET=seu_segredo_sso_aqui

# --- Scripts de Seed (seed:admin, seed:checklists) ---
#
# ADMIN_PASSWORD (opcional) — password em claro do Super Admin usada pelo
#   script `npm run seed:admin` (backend/seed-admin.js). Se não definida,
#   o script gera uma password aleatória segura e imprime-a UMA ÚNICA VEZ
#   na consola. O SSO não usa esta password (autentica via JWT do Autocell);
#   serve apenas como fallback de emergência pelo login normal.
# ADMIN_PASSWORD=
#
# EMPRESA_ID (opcional) — ID da empresa âncora. Usado pelo `seed:admin`
#   (empresa do Super Admin) e pelo `seed:checklists`. Se não definida:
#     • seed:admin → find-or-cria a empresa-sistema "All2gether (Sistema)".
#     • seed:checklists → usa a primeira empresa existente na BD.
# EMPRESA_ID=

# --- Emissão de Webhooks (Outbound) para o portal Autocell ---
# Quando ocorrem eventos críticos no All2gether (ex.: relatório submetido,
# tarefas pendentes no Cão de Guarda), o sistema envia um POST assíncrono
# (M2M) para o Autocell com um payload esparso assinado com HMAC-SHA256.
#
# AUTOCELL_WEBHOOK_URL — endpoint do Autocell que recebe os webhooks.
# AUTOCELL_WEBHOOK_SECRET — segredo usado para gerar a assinatura
#   X-All2gether-Signature (HMAC-SHA256 do corpo JSON). Tem de ser idêntico
#   no Autocell (que o usa para verificar a autenticidade do webhook).
#   Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Se AMBIAS as variáveis não estiverem definidas, o utilitário
# enviarEventoParaAutocell() faz apenas console.log (útil em dev) e NÃO
# tenta o pedido de rede — os eventos são silenciosamente ignorados.
AUTOCELL_WEBHOOK_URL=http://url-do-autocell/api/webhooks/all2gether
AUTOCELL_WEBHOOK_SECRET=o_mesmo_segredo_usado_no_autocell

# --- Notificações Push (Web Push API / VAPID) ---
# Gera as chaves com: npx web-push generate-vapid-keys
# (corre na pasta backend/ após npm install)
#
# VAPID_PUBLIC_KEY  — chave pública (partilhada com o browser para subscrição)
# VAPID_PRIVATE_KEY — chave privada (guarda sigilosamente; assina as notificações)
# VAPID_SUBJECT     — identificador do emissor (email ou URL):
#                     ex: mailto:admin@all2gether.com
#
# Sem estas variáveis, o endpoint /api/auth/me/push-subscribe devolve 503
# (serviço não configurado) e as notificações push são ignoradas silenciosamente.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@all2gether.com
